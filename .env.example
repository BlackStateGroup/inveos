INVEOS_DEV_LAB=1
NODE_ENV=development
INVEOS_API_HOST=127.0.0.1
INVEOS_API_PORT=3001
INVEOS_DATABASE_URL=postgres://inveos_app@127.0.0.1:5432/inveos_lab
INVEOS_ADMIN_DATABASE_URL=postgres://inveos_admin@127.0.0.1:5432/inveos_lab
INVEOS_TEST_DATABASE_URL=postgres://inveos_app@127.0.0.1:5432/inveos_test
INVEOS_TEST_ADMIN_DATABASE_URL=postgres://inveos_admin@127.0.0.1:5432/inveos_test
INVEOS_STORAGE_ROOT=/home/ubuntu/repos/inveos/.local-data/objects
INVEOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INVEOS_DEMO_TENANT_ID=00000000-0000-4000-8000-000000000001
INVEOS_DEMO_USER_ID=00000000-0000-4000-8000-000000000002
INVEOS_SESSION_TTL_SECONDS=28800

# Rotate to a fresh UUID outside the database backup before restoring/reopening access.
# All API instances must use the same value; never reuse a retired generation.
INVEOS_SESSION_EPOCH=00000000-0000-4000-8000-000000000000

# Optional fresh-store encryption; see docs/81_ENCRYPTED_ORIGINAL_CUSTODY.md.
# INVEOS_ORIGINAL_STORAGE_MODE=encrypted-v1
# INVEOS_ORIGINAL_KEYS_FILE=/absolute/private/path/original-keys.json

# Optional development-only pinned provider integration; see docs/83_PROVIDER_IDENTITY.md.
# Enrol verified fictional issuer/subject bindings before enabling. No automatic accounts.
# INVEOS_IDENTITY_MODE=oidc-pinned
# INVEOS_IDENTITY_CONFIG=/absolute/private/path/fictional-oidc.json
